# Copy to .env and adjust. Never commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development
# Origin the browser app is served from (used for CSRF origin checks).
CLIENT_ORIGIN=http://localhost:5173
# SQLite file (directory is created automatically).
DATABASE_PATH=./data/app.db
SESSION_TTL_DAYS=14
# bcrypt cost factor. 12 is a sensible production value.
BCRYPT_ROUNDS=12
# Set to 1 when running behind a reverse proxy (correct client IPs for rate limits, secure cookies).
TRUST_PROXY=0
MAX_RESUMES_PER_USER=25

# --- PDF export ---
# Path to Chrome/Chromium. Auto-detected on macOS/Linux/Windows when empty.
CHROME_PATH=
# Set to 1 only inside containers that cannot use Chrome's sandbox.
PDF_NO_SANDBOX=0

# --- Rate limits ---
RATE_LIMIT_AUTH_MAX=10   # login/register attempts per 15 min per IP
RATE_LIMIT_PDF_MAX=20    # PDF exports per minute per IP
RATE_LIMIT_API_MAX=300   # all API calls per minute per IP
